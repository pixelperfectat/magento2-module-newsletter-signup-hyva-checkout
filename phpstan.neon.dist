includes:
    # Shared level, bootstrap (bitexpert/phpstan-magento) and defaults.
    - vendor/pixelperfectat/coding-standard/phpstan.neon
    - phpstan-baseline.neon

parameters:
    phpVersion: 80300
    paths:
        - src
    excludePaths:
        - '*.sync-conflict-*'
    # Magewire ships with the commercial Hyvä Checkout and is not installable in CI: analyse against a stand-in.
    scanFiles:
        - Test/Stubs/Component.php
